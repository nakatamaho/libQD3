namespace {

const int kIterations = 24;

enum class Domain { any, nonzero, positive, unit, above1, wide };

struct Rng {
  std::uint64_t state;
  explicit Rng(std::uint64_t seed) : state(seed) {}
  // Uniform double in [0, 1) with 53 random bits.
  double next() {
    state ^= state << 13;
    state ^= state >> 7;
    state ^= state << 17;
    return static_cast<double>(state >> 11) * 0x1.0p-53;
  }
};

// Random quad-double with all four limbs populated, scaled to the domain.
qd_real random_qd(Rng &rng, Domain domain) {
  qd_real u(rng.next());
  double scale = 0x1.0p-53;
  for (int i = 1; i < 4; ++i, scale *= 0x1.0p-53) u += rng.next() * scale;
  const bool negative = rng.next() < 0.5;
  switch (domain) {
  case Domain::positive: return 0.5 + 3.5 * u;
  case Domain::unit: return (negative ? -0.9 : 0.9) * u;
  case Domain::above1: return 1.1 + 3.0 * u;
  case Domain::wide: return (negative ? -50.0 : 50.0) * u;
  case Domain::any:
  case Domain::nonzero:
  default: return (negative ? -1.0 : 1.0) * (0.5 + 1.5 * u);
  }
}

double random_double(Rng &rng, Domain domain) {
  return to_double(random_qd(rng, domain));
}

struct dd_tag {};
struct td_tag {};
struct qd_tag {};
struct ds_tag {};
struct ts_tag {};
struct qs_tag {};
struct edd_tag {};

template <class Tag> struct Operand;

template <> struct Operand<dd_tag> {
  double limbs[2];
  Operand() : limbs() {}
  explicit Operand(const qd_real &q) {
    const dd_real d = to_dd_real(q);
    limbs[0] = d.x[0];
    limbs[1] = d.x[1];
  }
  qd_real value() const { return qd_real(dd_real(limbs)); }
  static double eps() { return dd_real::_eps; }
  static int digits() { return dd_real::_ndigits; }
};

template <> struct Operand<td_tag> {
  double limbs[3];
  Operand() : limbs() {}
  explicit Operand(const qd_real &q) {
    const td_real t = to_td_real(q);
    for (int i = 0; i < 3; ++i) limbs[i] = t[i];
  }
  qd_real value() const { return to_qd_real(td_real(limbs)); }
  static double eps() { return td_real::_eps; }
  static int digits() { return td_real::_ndigits; }
};

template <> struct Operand<qd_tag> {
  double limbs[4];
  Operand() : limbs() {}
  explicit Operand(const qd_real &q) {
    for (int i = 0; i < 4; ++i) limbs[i] = q[i];
  }
  qd_real value() const { return qd_real(limbs); }
  static double eps() { return qd_real::_eps; }
  static int digits() { return qd_real::_ndigits; }
};

// binary32 expansions: built by rounding the quad-double limb by limb; the
// value of the limbs is then read back exactly.
template <int N> struct SingleOperand {
  float limbs[N];
  SingleOperand() : limbs() {}
  explicit SingleOperand(const qd_real &q) {
    single_real<N> v(q[0]);
    for (int i = 1; i < 4; ++i) v += single_real<N>(q[i]);
    for (int i = 0; i < N; ++i) limbs[i] = v.x[i];
  }
  qd_real value() const {
    qd_real r(0.0);
    for (int i = 0; i < N; ++i) r += static_cast<double>(limbs[i]);
    return r;
  }
  static double eps() { return static_cast<double>(single_real<N>::_eps); }
  static int digits() { return single_real<N>::_ndigits; }
};
template <> struct Operand<ds_tag> : SingleOperand<2> {
  Operand() {}
  explicit Operand(const qd_real &q) : SingleOperand<2>(q) {}
};
template <> struct Operand<ts_tag> : SingleOperand<3> {
  Operand() {}
  explicit Operand(const qd_real &q) : SingleOperand<3>(q) {}
};
template <> struct Operand<qs_tag> : SingleOperand<4> {
  Operand() {}
  explicit Operand(const qd_real &q) : SingleOperand<4>(q) {}
};

#ifdef QD_HAVE_EDD_REAL
// Exact binary64 split of a binary64x limb (at most 64 significant bits).
inline void split_word(_Float64x x, double &hi, double &lo) {
  hi = static_cast<double>(x);
  lo = static_cast<double>(x - static_cast<_Float64x>(hi));
}

template <> struct Operand<edd_tag> {
  _Float64x limbs[2];
  Operand() : limbs() {}
  explicit Operand(const qd_real &q) {
    const _Float64x hi = static_cast<_Float64x>(q[0]) + static_cast<_Float64x>(q[1]);
    double h0, h1;
    split_word(hi, h0, h1);
    const qd_real rest = q - (qd_real(h0) + h1);
    limbs[0] = hi;
    limbs[1] = static_cast<_Float64x>(rest[0]) + static_cast<_Float64x>(rest[1]);
  }
  qd_real value() const {
    double a, b, c, d;
    split_word(limbs[0], a, b);
    split_word(limbs[1], c, d);
    return ((qd_real(a) + b) + c) + d;
  }
  static double eps() { return static_cast<double>(edd_real::_eps); }
  static int digits() { return edd_real::_ndigits; }
};
#endif

template <class Tag> qd_real ref_of(const Operand<Tag> &a) { return a.value(); }
inline qd_real ref_of(double a) { return qd_real(a); }

// An operand of type Tag equal to, or a relative 1e-40 / 1e-70 away from,
// the reference value; used to check mixed-precision comparisons.
template <class Tag> Operand<Tag> near_operand(const qd_real &ref, int iter) {
  static const double offsets[] = {0.0, 1e-40, -1e-40, 1e-70, -1e-70, 0.0};
  return Operand<Tag>(ref + ref * offsets[iter % 6]);
}
inline double near_double(const qd_real &ref, int iter) {
  static const double offsets[] = {0.0, 1e-40, -1e-40, 1e-20, -1e-20, 0.0};
  return to_double(ref + ref * offsets[iter % 6]);
}

struct Report {
  int checks;
  int failures;
  Report() : checks(0), failures(0) {}

  void check(const char *name, bool ok) {
    ++checks;
    if (!ok) {
      ++failures;
      std::cerr << "FAIL c_api_test: " << name << "\n";
    }
  }

  // |got - expected| <= k * eps * max(|expected|, 1); k == 0 means exact.
  void close(const char *name, const qd_real &got, const qd_real &expected,
             double eps, double k) {
    ++checks;
    const qd_real err = abs(got - expected);
    qd_real scale = abs(expected);
    if (scale < 1.0) scale = 1.0;
    const bool ok = (k == 0.0) ? (got == expected) : (err <= k * eps * scale);
    if (!ok) {
      ++failures;
      std::cerr << "FAIL c_api_test: " << name << " relative error "
                << to_double(err / scale) / eps << " eps (limit " << k
                << ")\n";
    }
  }
};

@CASES@

