int main() {
  Rng rng(0x9E3779B97F4A7C15ULL);
  Report report;
  {
    unsigned int old_cw = 0;
    fpu_fix_start(&old_cw);
@RUNS_DOUBLE@    fpu_fix_end(&old_cw);
  }
#ifdef QD_HAVE_EDD_REAL
  {
    unsigned int old_cw = 0;
    fpu_fix_start_80bit(&old_cw);
@RUNS_EDD@    fpu_fix_end(&old_cw);
  }
#endif
  std::cout << "c_api_test: " << (report.checks - report.failures) << "/"
            << report.checks << " checks passed\n";
  return report.failures == 0 ? 0 : 1;
}
