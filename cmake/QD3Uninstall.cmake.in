set(QD3_INSTALL_MANIFEST "@CMAKE_BINARY_DIR@/install_manifest.txt")

if(NOT EXISTS "${QD3_INSTALL_MANIFEST}")
  message(FATAL_ERROR "Cannot find install manifest: ${QD3_INSTALL_MANIFEST}")
endif()

file(STRINGS "${QD3_INSTALL_MANIFEST}" QD3_INSTALLED_FILES)
foreach(QD3_INSTALLED_FILE IN LISTS QD3_INSTALLED_FILES)
  if(QD3_INSTALLED_FILE STREQUAL "")
    continue()
  endif()

  set(QD3_UNINSTALL_FILE "${QD3_INSTALLED_FILE}")
  set(QD3_DESTDIR "$ENV{DESTDIR}")
  if(QD3_DESTDIR)
    string(FIND "${QD3_INSTALLED_FILE}" "${QD3_DESTDIR}/" QD3_DESTDIR_POSITION)
    if(NOT QD3_DESTDIR_POSITION EQUAL 0)
      set(QD3_UNINSTALL_FILE "${QD3_DESTDIR}${QD3_INSTALLED_FILE}")
    endif()
  endif()

  if(EXISTS "${QD3_UNINSTALL_FILE}" OR IS_SYMLINK "${QD3_UNINSTALL_FILE}")
    message(STATUS "Removing ${QD3_UNINSTALL_FILE}")
    file(REMOVE "${QD3_UNINSTALL_FILE}")
    if(EXISTS "${QD3_UNINSTALL_FILE}" OR IS_SYMLINK "${QD3_UNINSTALL_FILE}")
      message(FATAL_ERROR "Failed to remove ${QD3_UNINSTALL_FILE}")
    endif()
  else()
    message(STATUS "File does not exist: ${QD3_UNINSTALL_FILE}")
  endif()
endforeach()
